<UserControl x:Class="FaizanCosmetics.UI.Views.SalesInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="F3" Command="{Binding OpenProductPickerCommand}" />
        <KeyBinding Key="F4" Command="{Binding SelectClientCommand}" />
        <KeyBinding Key="F5" Command="{Binding NewInvoiceCommand}" />
        <KeyBinding Key="F6" Command="{Binding PostInvoiceCommand}" />
        <KeyBinding Key="F8" Command="{Binding PrintCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelOperationCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="New Invoice" Style="{StaticResource HeaderText}" />
            <TextBlock Grid.Column="1" Style="{StaticResource SubHeaderText}" FontSize="11" VerticalAlignment="Center">
                F2 Barcode · F3 Search Product · F4 Client · F5 New · F6 Post · F7 Payment · F8 Print · Esc Cancel
            </TextBlock>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Style="{StaticResource ValidationMessageText}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BarcodeTextBox" Grid.Column="0" Style="{StaticResource AppTextBox}" FontSize="18" Padding="12,10"
                     Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" Tag="Scan or type barcode, then press Enter...">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ScanBarcodeCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="2" Content="Find Product (F3)" Style="{StaticResource SecondaryButton}" Command="{Binding OpenProductPickerCommand}" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Cart -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0" ItemsSource="{Binding CartLines}" SelectedItem="{Binding SelectedLine}" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTextColumn Header="Disc Amt" Binding="{Binding DiscountAmount, StringFormat=N2}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat=N2}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="100" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="1" Content="Remove Selected Line" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveLineCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
            </Grid>

            <!-- Customer, Payment, Totals -->
            <StackPanel Grid.Column="2">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="CUSTOMER" Style="{StaticResource TileLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ClientDisplayName}" Style="{StaticResource SubHeaderText}" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4" />
                        <TextBlock Style="{StaticResource BodyText}" Visibility="{Binding ClientIsWalkIn, Converter={StaticResource BooleanToVisibilityConverter2}, ConverterParameter=Invert}">
                            <Run Text="Balance: "  /><Run Text="{Binding ClientOutstandingBalance, StringFormat=N2}" FontWeight="Bold" />
                            <LineBreak />
                            <Run Text="Credit Limit: " /><Run Text="{Binding ClientCreditLimit, StringFormat=N2}" />
                        </TextBlock>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Select (F4)" Style="{StaticResource SecondaryButton}" Command="{Binding SelectClientCommand}" Padding="8,6" />
                            <Button Grid.Column="2" Content="Walk-in" Style="{StaticResource SecondaryButton}" Command="{Binding ClearClientCommand}" Padding="8,6" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PAYMENT" Style="{StaticResource TileLabel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" Padding="8,6" Margin="0,6,0,8" />
                        <TextBlock Text="Amount Paid" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox x:Name="PaidAmountTextBox" Style="{StaticResource AppTextBox}" FontSize="16"
                                 Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Invoice Discount %" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding InvoiceDiscountPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Subtotal" Style="{StaticResource BodyText}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SubTotal, StringFormat=N2}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Discount" Style="{StaticResource BodyText}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding DiscountAmount, StringFormat=N2}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tax" Style="{StaticResource BodyText}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TaxAmount, StringFormat=N2}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="GRAND TOTAL" Style="{StaticResource SubHeaderText}" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding GrandTotal, StringFormat=N2}" Style="{StaticResource TotalAmountText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Due" Style="{StaticResource BodyText}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding DueAmount, StringFormat=N2}" Style="{StaticResource BodyText}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <Button Content="Post Invoice (F6)" Style="{StaticResource PrimaryButton}" Command="{Binding PostInvoiceCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" FontSize="15" Padding="18,14" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
