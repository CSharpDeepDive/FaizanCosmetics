<UserControl x:Class="FaizanCosmetics.UI.Views.PurchaseInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Purchase Entry" Style="{StaticResource HeaderText}" />
            <Button Grid.Column="1" Content="New Purchase" Style="{StaticResource SecondaryButton}" Command="{Binding NewPurchaseCommand}" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Style="{StaticResource ValidationMessageText}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,8,0,0" TextWrapping="Wrap" />

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="+ Add Product" Style="{StaticResource PrimaryButton}" Command="{Binding AddProductCommand}"
                        HorizontalAlignment="Left" Margin="0,0,0,12" />

                <DataGrid Grid.Row="1" ItemsSource="{Binding CartLines}" SelectedItem="{Binding SelectedLine}" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Disc %" Binding="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTextColumn Header="Disc Amt" Binding="{Binding DiscountAmount, StringFormat=N2}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat=N2}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="100" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="2" Content="Remove Selected Line" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveLineCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
            </Grid>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource TileBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="SUPPLIER" Style="{StaticResource TileLabel}" />
                        <TextBlock Text="{Binding SupplierDisplayName}" Style="{StaticResource SubHeaderText}" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4" />
                        <TextBlock Style="{StaticResource BodyText}" >
                            <Run Text="Owed: "  /><Run Text="{Binding SupplierOutstandingBalance, StringFormat=N2}" FontWeight="Bold" />
                        </TextBlock>
                        <Button Content="Select Supplier" Style="{StaticResource SecondaryButton}" Command="{Binding SelectSupplierCommand}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TileBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PAYMENT" Style="{StaticResource TileLabel}" />
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" Padding="8,6" Margin="0,6,0,8" />
                        <TextBlock Text="Amount Paid Now" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" FontSize="16" Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Text="Supplier Invoice Ref (optional)" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding SupplierInvoiceReference, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TileBorder}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Subtotal" Style="{StaticResource BodyText}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SubTotal, StringFormat=N2}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Discount" Style="{StaticResource BodyText}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding DiscountAmount, StringFormat=N2}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Tax" Style="{StaticResource BodyText}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TaxAmount, StringFormat=N2}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="GRAND TOTAL" Style="{StaticResource SubHeaderText}" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding GrandTotal, StringFormat=N2}" Style="{StaticResource TotalAmountText}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Due" Style="{StaticResource BodyText}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding DueAmount, StringFormat=N2}" Style="{StaticResource BodyText}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <Button Content="Post Purchase" Style="{StaticResource PrimaryButton}" Command="{Binding PostInvoiceCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" FontSize="15" Padding="18,14" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
