<Window x:Class="FaizanCosmetics.UI.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="400" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderTextBlock" Text="Set a new password" Style="{StaticResource HeaderText}" FontSize="18" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Current Password" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
            <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource AppPasswordBox}" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="New Password" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource AppPasswordBox}" />
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Confirm New Password" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource AppPasswordBox}" />
        </StackPanel>

        <TextBlock Grid.Row="8" x:Name="ErrorTextBlock" Style="{StaticResource ValidationMessageText}" TextWrapping="Wrap" Visibility="Collapsed" />

        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click" />
            <Button Grid.Column="2" Content="Save" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
        </Grid>
    </Grid>
</Window>
