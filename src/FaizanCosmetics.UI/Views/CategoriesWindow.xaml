<Window x:Class="FaizanCosmetics.UI.Views.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categories" Height="560" Width="640"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Categories" Style="{StaticResource HeaderText}" FontSize="18" />
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Style="{StaticResource ValidationMessageText}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,6,0,0" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" SelectionMode="Single" Margin="0,12,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                <DataGridTextColumn Header="Products" Binding="{Binding ProductCount}" Width="80" />
                <DataGridTextColumn Header="Status" Binding="{Binding IsActive, Converter={StaticResource ActiveStatusConverter}}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Add New Category" Style="{StaticResource SubHeaderText}" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Tag="Name" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding NewCategoryDescription, UpdateSourceTrigger=PropertyChanged}" Tag="Description (optional)" Margin="0,0,0,8" />
                <Button Content="Add Category" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Edit Selected Category" Style="{StaticResource SubHeaderText}" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Save" Style="{StaticResource SecondaryButton}" Command="{Binding SaveEditCommand}" />
                    <Button Grid.Column="2" Content="Deactivate" Style="{StaticResource DangerButton}" Command="{Binding DeactivateCommand}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
