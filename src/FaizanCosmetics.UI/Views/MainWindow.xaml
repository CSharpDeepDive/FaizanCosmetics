<Window x:Class="FaizanCosmetics.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FaizanCosmetics.UI.ViewModels"
        xmlns:views="clr-namespace:FaizanCosmetics.UI.Views"
        xmlns:controls="clr-namespace:FaizanCosmetics.UI.Views.Controls"
        Title="Faizan Cosmetics" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- WPF resolves these by the CLR type of the bound object (CurrentView), so navigating
             just needs to set CurrentView to the right ViewModel instance. Views are DI-constructed
             here (not "new Foo()") so each still gets its own constructor-injected ViewModel. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LowStockViewModel}">
            <views:LowStockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
            <views:ClientsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesInvoiceViewModel}">
            <views:SalesInvoiceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesHistoryViewModel}">
            <views:SalesHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <views:SuppliersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseInvoiceViewModel}">
            <views:PurchaseInvoiceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseHistoryViewModel}">
            <views:PurchaseHistoryView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Faizan Cosmetics" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUserFullName}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="(" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentUserRole}" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text=")" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding CurrentDateTime, StringFormat='dddd, dd MMM yyyy  HH:mm'}" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <Rectangle Width="1" Height="20" Fill="White" Opacity="0.3" Margin="0,0,12,0" />
                    <controls:AetheriaLogoMark Width="16" Height="16" Margin="0,0,6,0" Opacity="0.85" />
                    <TextBlock Foreground="White" VerticalAlignment="Center" FontSize="11" Opacity="0.85">
                        <Run Text="Aetheria Labs" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavigationSections}" Margin="0,12,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="16,10,0,4"
                                               Visibility="{Binding Title, Converter={StaticResource NullToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding NavigateCommand}" HorizontalContentAlignment="Left"
                                                        Padding="16,9" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        HorizontalAlignment="Stretch">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}">
                                                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
        </Grid>
    </Grid>
</Window>
