<Window x:Class="FaizanCosmetics.UI.Views.SupplierEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="560" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" Style="{StaticResource HeaderText}" FontSize="18" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ValidationMessageText}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,0,10" />

                <TextBlock Text="Name *" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phone" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Contact Person" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Email" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,0,0,12" />

                <TextBlock Text="Address" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}"
                         AcceptsReturn="True" Height="56" TextWrapping="Wrap" Margin="0,0,0,12" />

                <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter2}, ConverterParameter=Invert}">
                    <TextBlock Text="Opening Balance (amount already owed to this supplier before using this system, if any)" Style="{StaticResource BodyText}" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBox Text="{Binding OpeningBalance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,0,0,12" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter2}}">
                    <TextBlock Text="Current Balance Owed" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CurrentBalance, StringFormat=N2}" Style="{StaticResource AppTextBox}" IsReadOnly="True" Margin="0,0,0,12" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
        </Grid>
    </Grid>
</Window>
