<Window x:Class="FaizanCosmetics.UI.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="680" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" Style="{StaticResource HeaderText}" FontSize="18" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,16">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ValidationMessageText}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,0,10" />

                <TextBlock Text="Product Name *" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Barcode * (scan or type)" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox x:Name="BarcodeTextBox" Style="{StaticResource AppTextBox}" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SKU *" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Category *" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory}" Padding="8,6" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Purchase Price *" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Selling Price *" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Wholesale Price *" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding WholesalePrice, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Minimum Stock" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding MinimumStockLevel, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Reorder Level" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Opening Stock" Style="{StaticResource BodyText}" Margin="0,0,0,4"
                                   Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter2}, ConverterParameter=Invert}" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding OpeningStock, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter2}, ConverterParameter=Invert}" />
                        <TextBlock Text="Current Stock" Style="{StaticResource BodyText}" Margin="0,0,0,4"
                                   Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter2}}" />
                        <TextBox Style="{StaticResource AppTextBox}" Text="{Binding CurrentStock, StringFormat=N2}" IsReadOnly="True"
                                 Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter2}}" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="This product has an expiry date (enables batch tracking)" IsChecked="{Binding HasExpiry}" Margin="0,0,0,12" />

                <TextBlock Text="Description" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                <TextBox Style="{StaticResource AppTextBox}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" Height="60" TextWrapping="Wrap" Margin="0,0,0,12" />

                <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter2}}">
                    <TextBlock Text="If you changed any price, record why:" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding PriceChangeReasons}" SelectedItem="{Binding SelectedPriceChangeReason}" Padding="8,6" Margin="0,0,0,8" />
                    <TextBox Style="{StaticResource AppTextBox}" Text="{Binding PriceChangeNotes, UpdateSourceTrigger=PropertyChanged}" Tag="Notes (optional)" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
        </Grid>
    </Grid>
</Window>
