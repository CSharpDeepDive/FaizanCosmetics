<Window x:Class="FaizanCosmetics.UI.Views.SupplierPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pay Supplier" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Pay Supplier" Style="{StaticResource HeaderText}" FontSize="18" />

        <StackPanel Grid.Row="1" Margin="0,16,0,16">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ValidationMessageText}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,0,10" />

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding SupplierName}" Style="{StaticResource SubHeaderText}" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Currently owed: " Style="{StaticResource BodyText}" />
                        <Run Text="{Binding CurrentBalance, StringFormat=N2}" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="Amount Paid *" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" FontSize="18" Margin="0,0,0,12" />

            <TextBlock Text="Payment Method" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" Padding="8,6" Margin="0,0,0,12" />

            <TextBlock Text="Reference Number (optional)" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
            <TextBox Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" Margin="0,0,0,12" />

            <TextBlock Text="Notes (optional)" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AppTextBox}" AcceptsReturn="True" Height="56" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Content="Pay" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
        </Grid>
    </Grid>
</Window>
