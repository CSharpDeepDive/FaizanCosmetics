<UserControl x:Class="FaizanCosmetics.UI.Views.Controls.AetheriaLogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40" Height="40">
    <!--
        Aetheria Labs mark: a four-point "sparkle/aether" star with a small orbiting dot, drawn
        as pure vector geometry so it renders crisply at any size with no external image asset
        to go missing at build time. LightColor/DarkColor are exposed as dependency-property-free
        static resources here (the palette from Styles/Colors.xaml) so the mark automatically
        matches the app's purple/pink cosmetics theme wherever it's placed.
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="40" Height="40">
            <Canvas.Resources>
                <LinearGradientBrush x:Key="MarkGradient" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
                    <GradientStop Color="{StaticResource PrimaryColor}" Offset="1" />
                </LinearGradientBrush>
            </Canvas.Resources>

            <!-- Large sparkle: four concave-sided points meeting at the center -->
            <Path Fill="{StaticResource MarkGradient}"
                  Data="M 20,2
                        C 21,12 22,18 34,20
                        C 22,22 21,28 20,38
                        C 19,28 18,22 6,20
                        C 18,18 19,12 20,2 Z" />

            <!-- Small orbiting sparkle, echoing the main mark -->
            <Path Fill="{StaticResource AccentBrush}" Opacity="0.85"
                  Data="M 32,4
                        C 32.5,7 33,8.5 37,9
                        C 33,9.5 32.5,11 32,14
                        C 31.5,11 31,9.5 27,9
                        C 31,8.5 31.5,7 32,4 Z" />
        </Canvas>
    </Viewbox>
</UserControl>
