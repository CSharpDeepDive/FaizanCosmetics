<UserControl x:Class="FaizanCosmetics.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Products" Style="{StaticResource HeaderText}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Low Stock" Style="{StaticResource SecondaryButton}" Command="{Binding ViewLowStockCommand}" Margin="0,0,10,0" />
                <Button Content="Categories" Style="{StaticResource SecondaryButton}" Command="{Binding OpenCategoriesCommand}" Margin="0,0,10,0" />
                <Button Content="+ Add Product" Style="{StaticResource PrimaryButton}" Command="{Binding AddProductCommand}" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Style="{StaticResource ValidationMessageText}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,8,0,0" />

        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}" Margin="0,0,10,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Search by barcode, SKU, or name...">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedCategory}" Margin="0,0,10,0" Padding="8,6" />
            <Button Grid.Column="2" Content="Search" Style="{StaticResource SecondaryButton}" Command="{Binding SearchCommand}" />
        </Grid>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130" />
                <DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130" />
                <DataGridTextColumn Header="Purchase Price" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="120" />
                <DataGridTextColumn Header="Selling Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="120" />
                <DataGridTextColumn Header="Stock" Binding="{Binding CurrentStock, StringFormat=N2}" Width="90" />
                <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumStockLevel, StringFormat=N2}" Width="90" />
                <DataGridTextColumn Header="Status" Binding="{Binding IsActive, Converter={StaticResource ActiveStatusConverter}}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Edit" Style="{StaticResource SecondaryButton}" Command="{Binding EditProductCommand}" Margin="0,0,10,0" />
                <Button Content="Activate / Deactivate" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleActiveCommand}" Margin="0,0,10,0" />
                <Button Content="Price History" Style="{StaticResource SecondaryButton}" Command="{Binding ViewPriceHistoryCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} products'}" Style="{StaticResource BodyText}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <Button Content="◀" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousPageCommand}" Padding="10,6" Margin="0,0,6,0" />
                <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">
                    <Run Text="{Binding CurrentPage}" /><Run Text=" / " /><Run Text="{Binding TotalPages}" />
                </TextBlock>
                <Button Content="▶" Style="{StaticResource SecondaryButton}" Command="{Binding NextPageCommand}" Padding="10,6" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
